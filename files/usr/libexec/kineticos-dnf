#!/usr/bin/env bash
# kineticos-dnf — the dnf entry point on kineticos.
#
# Installed over /usr/bin/dnf AND /usr/bin/dnf5 by the `overlay` module (which
# runs last, after all build-time dnf usage). /usr/bin/yum and /usr/bin/microdnf
# are symlinks to /usr/bin/dnf5, so they land here too. The real dnf5 binary is
# copied to /usr/libexec/dnf5.
#
# Every mutation of the persistent /usr overlay is funnelled through kinpkg, or
# refused. A plain `dnf install`/`autoremove` writes into the overlay's upperdir,
# shadowing the image, surviving reboots, and silently defeating bootc's
# atomicity.
#
# Behaviour:
#   * install / remove / reinstall                        -> kinpkg
#     (its base-package guardrails and its record of overlay packages;
#      reinstall is overlay-packages-only)
#   * update / upgrade                                    -> kineticos-update
#     (stages a new bootc deployment — the image, not the overlay)
#   * downgrade / distro-sync / swap /
#     autoremove / system-level verbs                    -> refused (exit 1)
#   * group/environment install|remove|upgrade            -> refused (exit 1)
#   * everything else (search, info, repoquery, clean, …) -> /usr/libexec/dnf5
#
# dcli-bootc itself never goes through this shim: it calls /usr/bin/kinpkg (and
# /usr/bin/rum) directly, and kinpkg calls /usr/libexec/dnf5 — so `dcli-bootc
# update` / `dcli-bootc overlay upgrade` keep working.

set -euo pipefail

REAL_DNF5=/usr/libexec/dnf5
KINPKG=/usr/bin/kinpkg
PROG="${0##*/}"

if [[ ! -x "$REAL_DNF5" ]]; then
    echo "kineticos-dnf: $REAL_DNF5 is missing — rebuild the image (dcli-bootc update)" >&2
    exit 127
fi

# --help / --version are harmless queries: let the real dnf5 answer them, even
# for `dnf upgrade --help`.
for arg in "$@"; do
    case "$arg" in
        --help|-h|--version)
            exec -a "$PROG" "$REAL_DNF5" "$@"
            ;;
    esac
done

# Only a booted ostree/bootc system has the persistent /usr overlay. During an
# image build (podman/bootc container) or a chroot there is no overlay to write
# into, so routing dnf through kinpkg would fail — and it must not: images
# layered on kineticos (e.g. `dcli-bootc init --extend`) run plain `dnf install`
# at build time. Delegate to the real dnf5 there.
if [[ ! -e /run/ostree-booted ]]; then
    exec -a "$PROG" "$REAL_DNF5" "$@"
fi

# Find the command: the first non-option argument, skipping the values of the
# global options that take a separate value. This keeps `dnf -y update` blocked
# and `dnf install <pkg-named-update>` allowed.
args=("$@")
cmd=""
rest=()
i=0
while [[ $i -lt ${#args[@]} ]]; do
    a="${args[$i]}"
    case "$a" in
        -c|--config|--setopt|--releasever|--installroot|--repo|--enable-repo|--disable-repo|--exclude|--disableexcludes|--enableplugin|--disableplugin)
            i=$((i + 2))
            continue
            ;;
        -*)
            i=$((i + 1))
            continue
            ;;
        *)
            cmd="$a"
            rest=("${args[@]:$((i + 1))}")
            break
            ;;
    esac
done

# Refuse system-level/mutating verbs that have no declarative overlay path. They
# would write into the overlay, shadowing the image and breaking rollbacks.
refuse_system() {
    cat >&2 <<'EOF'
kragnetic: refusing a system-level package operation through dnf.

  /usr is a persistent overlay managed declaratively by dcli-bootc. Changing
  the image's packages through dnf writes into the overlay, shadows the image,
  and breaks bootc rollbacks.

  System image update:    sudo dnf update      (or: sudo ki update)
  Overlay packages only:  sudo kinpkg overlay-upgrade
  Reconcile overlay set:  sudo kinpkg sync

EOF
    exit 1
}

case "$cmd" in
    autoremove)
        # Autoremove reasons over the *merged* rpmdb, so it can remove packages
        # the base image provides — unlinking them through /usr leaves overlayfs
        # whiteouts that hide the base copies permanently.
        cat >&2 <<'EOF'
kragnetic: refusing 'autoremove'.

  Autoremove reasons over the merged rpmdb and can remove packages the base
  image provides, leaving overlayfs whiteouts that hide them permanently.

  To drop overlay packages, remove them from the overlay module and run:
      dcli-bootc overlay sync

EOF
        exit 1
        ;;
    upgrade|up|update)
        # The image is the source of truth: a system update stages a new bootc
        # deployment, handled by kineticos-update rather than dnf. Keep the
        # confirmation/reboot flags even when they preceded the command
        # (e.g. `dnf -y update`); drop dnf's other global options.
        update_args=("${rest[@]}")
        for a in "${args[@]:0:$i}"; do
            case "$a" in
                -y|--yes|--assumeyes|--reboot) update_args+=("$a") ;;
            esac
        done
        exec /usr/libexec/kineticos-update "${update_args[@]}"
        ;;
    distro-sync|dsync|downgrade|dg|swap|replay|debuginfo-install|offline-upgrade|offline-distrosync|system-upgrade)
        refuse_system
        ;;
    group|environment)
        # `dnf group list` is read-only; `dnf group install foo` mutates.
        sub=""
        for a in "${rest[@]}"; do
            case "$a" in
                -*) ;;
                *) sub="$a"; break ;;
            esac
        done
        case "$sub" in
            install|remove|upgrade|mark) refuse_system ;;
        esac
        ;;
esac

# Adding to or removing from the overlay goes through kinpkg, from any entry
# point (dnf, dnf5, yum, microdnf). kinpkg only understands the command
# (optionally preceded by -y), so anything else is refused rather than handed
# to raw dnf5.
case "$cmd" in
    install|in|remove|rm|reinstall|rein)
        case "${1:-}" in
            install|in|remove|rm|reinstall|rein|-y|--yes|--assumeyes)
                exec "$KINPKG" "$@"
                ;;
            *)
                echo "kragnetic: unsupported invocation of '$cmd' — put global options after the command, or run 'sudo kinpkg $cmd ...'" >&2
                exit 1
                ;;
        esac
        ;;
esac

# Everything else is delegated unchanged, preserving argv[0] so dnf5's
# yum/microdnf compatibility modes still behave.
exec -a "$PROG" "$REAL_DNF5" "$@"
